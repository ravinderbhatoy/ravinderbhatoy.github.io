---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
---

<style></style>

<BaseLayout>
    <div class="hero box">
        <img
            class="profile-img"
            src={`${baseUrl}profile.png`}
            alt="profile-image"
        />
        <div>
            <h2>Hi, I'm Ravinder.</h2>
            <p>
                Computer Application Student having fun while learning and
                sharing knowledge.
            </p>
            <div class="social-icons">
                <a href="https://leetcode.com/u/zrpZTiWq3S/" target="_blank">
                    <img src={`${baseUrl}leetcode.svg`} alt="leetcode-icon" />
                </a>
                <a href="https://github.com/ravinderbhatoy" target="_blank">
                    <img src={`${baseUrl}github.svg`} alt="github-icon" />
                </a>
                <a href="mailto:ravinderd.bhatoy@gmail.com" target="_blank">
                    <img src={`${baseUrl}mail.svg`} alt="mail-icon" />
                </a>
            </div>
        </div>
    </div>
    <hr />
</BaseLayout>
